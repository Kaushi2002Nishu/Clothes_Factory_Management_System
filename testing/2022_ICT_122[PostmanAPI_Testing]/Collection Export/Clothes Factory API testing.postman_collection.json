		{
			"name": "Create Order",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							" \r",
							"pm.test(\"Order created successfully\", function () {\r",
							"    let data = pm.response.json();\r",
							" \r",
							"    pm.expect(data).to.have.property(\"_id\");\r",
							"    pm.expect(data.customerName).to.eql(\"Siva\");\r",
							"    pm.expect(data.quantity).to.eql(10);\r",
							"});\r",
							""
						],
