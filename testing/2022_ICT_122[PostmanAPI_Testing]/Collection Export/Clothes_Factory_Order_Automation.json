							"script": {
								"exec": [
									"// Test 1: Status Code\r",
									"pm.test(\"Status code should be 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"// Test 2: Delete Success Message\r",
									"pm.test(\"Order deleted successfully\", function () {\r",
									"    const responseData = pm.response.json();\r",
									"\r",
									"    pm.expect(responseData.message)\r",
									"        .to.eql(\"Order deleted successfully\");\r",
									"});\r",
									"\r",
									"// Test 3: Response should be JSON\r",
									"pm.test(\"Response should be JSON\", function () {\r",
									"    pm.response.to.be.json;\r",
									"});"
