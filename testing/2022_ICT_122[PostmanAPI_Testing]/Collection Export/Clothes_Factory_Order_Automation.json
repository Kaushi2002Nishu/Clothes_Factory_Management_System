								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Customer name updated\", function () {\r",
									"    const responseData = pm.response.json();\r",
									"\r",
									"    pm.expect(responseData.customerName)\r",
									"        .to.eql(\"Suresh Updated\");\r",
									"});\r",
									"\r",
									"pm.test(\"Product is frocks\", function () {\r",
									"    const responseData = pm.response.json();\r",
									"\r",
									"    pm.expect(responseData.product)\r",
									"        .to.eql(\"frocks\");\r",
									"});\r",
									"\r",
									"pm.test(\"Quantity updated to 100\", function () {\r",
									"    const responseData = pm.response.json();\r",
									"\r",
									"    pm.expect(responseData.quantity).to.eql(100);\r",
									"});\r",
									"\r",
									"pm.test(\"Status updated to processing\", function () {\r",
									"    const responseData = pm.response.json();\r",
									"\r",
									"    pm.expect(responseData.status)\r",
									"        .to.eql(\"processing\");\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
